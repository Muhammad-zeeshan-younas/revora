PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DEMO_ENABLED=true
# Local development uses a durable SQLite file. Set DATABASE_URL for PostgreSQL.
# DATABASE_URL=postgres://revora:revora@localhost:5432/revora
# Password reset email (requires a verified sending domain):
# RESEND_API_KEY=
# EMAIL_FROM=Revora <accounts@example.com>
# Authenticator MFA uses a 32-byte AES key encoded as 64 hexadecimal characters.
# MFA_ENCRYPTION_KEY=
# Operations health checks require a private bearer token of at least 32 characters.
# OPERATIONS_TOKEN=
# Run `npm run monitor` in a separate managed process. Supply an HTTPS JSON webhook.
# OPERATIONS_URL=http://127.0.0.1:3001/api/health/operations
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=
# OPERATIONS_STATE_FILE=data/operations-alert-state.json
# An isolated empty database is required only for the optional PostgreSQL benchmark.
# BENCHMARK_DATABASE_URL=postgres://revora:revora@localhost:5432/revora_benchmark
# Optional Meta WhatsApp Business Cloud API for one pilot organization.
# Sending stays disabled until all values are configured and customers have recorded consent.
# The approved utility template body must have three text parameters: customer name,
# invoice number, and outstanding amount (for example, Rs 1000.00).
# WHATSAPP_ORGANIZATION_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_GRAPH_VERSION=
# Schema changes use versioned TypeORM migrations. Automatic schema synchronization is disabled.
# Run yarn db:migrate to apply pending migrations explicitly; backend startup also applies them.
NODE_ENV=development
