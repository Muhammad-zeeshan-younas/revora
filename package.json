{
  "name": "revora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig tsconfig.api.json server/main.ts",
    "db:migrate": "tsx --tsconfig tsconfig.api.json server/database/migrate.ts",
    "db:backup": "tsx --tsconfig tsconfig.api.json scripts/backup.ts",
    "monitor": "node dist-api/scripts/monitor.js --watch",
    "monitor:once": "node dist-api/scripts/monitor.js",
    "benchmark:records": "tsx --tsconfig tsconfig.api.json scripts/benchmark-record-pages.ts",
    "db:seed": "tsx --tsconfig tsconfig.api.json server/database/seed.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.api.json",
    "start": "node dist-api/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^13.9.0",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.25",
    "vue": "^3.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "sass": "^1.90.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.0.0"
  }
}
